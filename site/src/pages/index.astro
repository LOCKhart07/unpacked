---
import Base from "../layouts/Base.astro";

const faq = [
  {
    q: "What is Unpacked?",
    a: "A free, open-source Discord data package viewer, analyzer and visualizer. You open the package.zip Discord sends you, and it turns it into charts and stats: playtime per game, Go Live and voice time, messages, time with Discord open, your account and what you've spent. It handles packages exported in 2026, in any language, and big ones too. It's like Discord Wrapped, for your whole account history.",
  },
  {
    q: "Is my Discord data uploaded anywhere?",
    a: "No. Your package never leaves your computer: the page reads your package.zip inside your browser tab and never sends it anywhere, unlike tools that ask for your package's download link so their server can fetch it. The only network requests are to Discord's public list of games and its game and emoji pictures. Results stay in your browser so you don't have to open the ZIP again, until you click Forget. The code is open source, so you can check.",
  },
  {
    q: "How do I get my Discord data package?",
    a: "In Discord, open User Settings → Data & Privacy and request your data. Discord emails a download link to your account's email address when it's ready, which Discord says can take up to 30 days.",
  },
  {
    q: "Why are my numbers higher than my Discord profile badges?",
    a: "Discord's Game Time, Streaming and Game Variety badges probably only count from about November 2024 (Discord doesn't say exactly). Your package goes back to when you made your account, so lifetime totals are much bigger. The stats page shows both.",
  },
  {
    q: "Can I see playtime for a single year?",
    a: "Not for games: the package only has one lifetime total per game. Streaming, camera and voice time come from dated events, so those can be shown for any year or the last 30 days, 6 months or 12 months.",
  },
  {
    q: "How is it different from Discord Data Package Explorer, Discord Package or Dumpus?",
    a: "It shows things they don't: playtime per game, Go Live and watch time, talking vs listening in voice, and how your lifetime totals compare with your badges. It also reads the activity data in packages exported in 2026, which the older explorers look for in a folder new packages no longer have. And unlike Dumpus, nothing is sent to a server.",
  },
  {
    q: "Is it free?",
    a: "Yes. There's no account, no ads and no upload. The code is on GitHub under the GPL-3.0 licence.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "Unpacked",
      url: "https://unpacked.lockhart.in/",
      description: "Free Discord data package viewer, analyzer and visualizer that runs in your browser.",
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Any (web browser)",
      browserRequirements: "Requires JavaScript",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      featureList: [
        "Playtime per game", "Go Live and stream watch time", "Voice time, talking vs listening",
        "Message stats, top DMs, servers and channels", "Time with Discord open", "Account, connections and money spent",
        "Shareable stats image", "Runs in the browser; nothing is uploaded",
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
    },
  ],
};
---

<Base
  title="Unpacked: Discord data package viewer and analyzer"
  description="Free Discord data package viewer, analyzer and visualizer. Open your package.zip to see playtime per game, Go Live and voice time, messages, time on Discord and more. Runs in your browser; nothing is uploaded."
>
  <div class="wrap">
    <section class="hero">
      <p class="kicker">Discord data package viewer and analyzer</p>
      <h1>Every hour you've spent on Discord, from your own data.</h1>
      <p class="lead muted">Open the package.zip Discord sent you and see your whole history as charts.</p>
      <div class="hero-actions">
        <a class="button big" href="/stats/">Open your package</a>
        <a class="button ghost big" href="/stats/?demo">Try with sample data</a>
      </div>
      <p class="promise muted">Read in your browser and never uploaded · Free · No account</p>
    </section>

    <section class="get-it" id="get-it">
      <h2>Don't have your package yet?</h2>
      <ol class="steps">
        <li>
          <strong>Request it</strong>
          <span class="muted">In Discord, open User Settings → Data &amp; Privacy → Request Data. Tick every section.</span>
        </li>
        <li>
          <strong>Wait for the email</strong>
          <span class="muted">Discord emails you a download link, which can take up to 30 days.</span>
        </li>
        <li>
          <strong>Open it here</strong>
          <span class="muted">Choose the package.zip. No need to unzip it.</span>
        </li>
      </ol>
      <p><a href="/request-your-discord-data/">Full step-by-step guide, for desktop and mobile</a></p>
    </section>

    <section class="features">
      <h2>What you'll see</h2>
      <ul>
        <li><strong>Playtime per game</strong> <span class="muted">for every game Discord has seen you play</span></li>
        <li><strong>Go Live and watch time</strong> <span class="muted">streamed, watched, your longest stream</span></li>
        <li><strong>Voice</strong> <span class="muted">talking vs listening, top servers and channels</span></li>
        <li><strong>Messages</strong> <span class="muted">top DMs and servers, favourite words and emoji</span></li>
        <li><strong>Time on Discord</strong> <span class="muted">hours with it open, per device</span></li>
        <li><strong>Account and spending</strong> <span class="muted">badges, connections, what you've paid for</span></li>
        <li><strong>Any time range</strong> <span class="muted">lifetime, a year or the last 30 days, shareable as an image</span></li>
      </ul>
      <p class="muted">
        Coming from another tool? See <a href="/discord-data-package-explorer-alternatives/">how the Discord data
        package viewers compare</a>.
      </p>
    </section>

    <section class="faq prose">
      <h2>Questions</h2>
      {faq.map(({ q, a }) => (
        <details>
          <summary>{q}</summary>
          <p class="muted">{a}</p>
        </details>
      ))}
    </section>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
</Base>

<style>
  .hero { padding-block: 40px 48px; max-width: 760px; }
  .lead { font-size: 1.2rem; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .button.big { font-size: 1.1rem; padding: 0.8em 1.6em; }
  .promise { margin: 14px 0 0; font-size: 0.9rem; }
  section > h2 { font-size: 1.3rem; }
  .get-it, .features { border-top: 1px solid var(--border); padding-block: 32px; }
  .steps { list-style: none; counter-reset: step; padding: 0; margin: 0 0 12px; display: grid; gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .steps li { counter-increment: step; display: flex; flex-direction: column; gap: 4px; }
  .steps li::before { content: counter(step); display: grid; place-items: center; width: 28px; height: 28px; margin-bottom: 6px;
    border-radius: 50%; background: var(--surface-2); color: var(--accent-2); font-weight: 700; font-size: 0.9rem; }
  .features ul { list-style: none; padding: 0; margin: 0 0 16px; display: grid; gap: 10px 32px;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .faq { border-top: 1px solid var(--border); padding-top: 32px; }
  .faq details { border-bottom: 1px solid var(--border); padding-block: 12px; }
  .faq summary { cursor: pointer; font-weight: 600; }
  .faq details p { margin: 8px 0 0; }
</style>
