---
import Base from "../layouts/Base.astro";

const faq = [
  {
    q: "What is Unpacked?",
    a: "A free, open-source Discord data package viewer and analyzer. You open the package.zip Discord sends you, and it turns it into charts and stats: playtime per game, Go Live and voice time, messages, time with Discord open, your account and what you've spent. It's like Discord Wrapped, for your whole account history.",
  },
  {
    q: "Is my Discord data uploaded anywhere?",
    a: "No. The page reads your package.zip inside your browser tab and never sends it anywhere. The only network requests are to Discord's public list of games and its game icons, to show your games' names and pictures.",
  },
  {
    q: "How do I get my Discord data package?",
    a: "In Discord, open User Settings → Data & Privacy and request your data. Discord emails a download link to your account's email address when it's ready, which Discord says can take up to 30 days.",
  },
  {
    q: "Why are my numbers higher than my Discord profile badges?",
    a: "Discord's Game Time, Streaming and Game Variety badges probably only count from about November 2024 (Discord doesn't say exactly). Your package goes back to when you made your account, so lifetime totals are much bigger. The stats page shows both.",
  },
  {
    q: "Can I see playtime for a single year?",
    a: "Not for games: the package only has one lifetime total per game. Streaming, camera and voice time come from dated events, so those can be shown for any year or the last 30 days, 6 months or 12 months.",
  },
  {
    q: "How is it different from Discord Data Package Explorer, Discord Package or Dumpus?",
    a: "It shows things they don't: playtime per game, Go Live and watch time, talking vs listening in voice, and how your lifetime totals compare with your badges. It also reads the activity data in packages exported in 2026, which the older explorers look for in a folder new packages no longer have. And unlike Dumpus, nothing is sent to a server.",
  },
  {
    q: "Is it free?",
    a: "Yes. There's no account, no ads and no upload. The code is on GitHub under the GPL-3.0 licence.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "Unpacked",
      url: "https://unpacked.lockhart.in/",
      description: "Free Discord data package viewer, analyzer and visualizer that runs in your browser.",
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Any (web browser)",
      browserRequirements: "Requires JavaScript",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      featureList: [
        "Playtime per game", "Go Live and stream watch time", "Voice time, talking vs listening",
        "Message stats, top DMs, servers and channels", "Time with Discord open", "Account, connections and money spent",
        "Shareable stats image", "Runs in the browser; nothing is uploaded",
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
    },
  ],
};
---

<Base
  title="Unpacked: Discord data package viewer and analyzer"
  description="Free Discord data package viewer, analyzer and visualizer. Open your package.zip to see playtime per game, Go Live and voice time, messages, time on Discord and more. Runs in your browser; nothing is uploaded."
>
  <div class="wrap">
    <section class="hero">
      <p class="kicker">Discord data package viewer and analyzer</p>
      <h1>Every hour you've spent on Discord, from your own data.</h1>
      <p class="lead muted">
        Playtime per game, Go Live and watch time, how much you talk in voice, and how your lifetime totals compare with
        your profile badges. Read straight from your Discord data package, in your browser.
      </p>
      <div class="hero-actions">
        <a class="button" href="/stats/">Open your package</a>
        <a class="button ghost" href="/request-your-discord-data/">How to get it</a>
        <a class="button ghost" href="/stats/?demo">Try with sample data</a>
      </div>
    </section>

    <section class="grid features">
      <div class="card">
        <h2>Playtime per game</h2>
        <p class="muted">Lifetime hours for every game Discord has seen you play, with duplicate game entries merged.</p>
      </div>
      <div class="card">
        <h2>Go Live and watch time</h2>
        <p class="muted">Hours streamed, what you streamed most, your longest stream, and time spent watching friends' streams and cameras.</p>
      </div>
      <div class="card">
        <h2>Voice: talking vs listening</h2>
        <p class="muted">Total time in voice, how much of it you were talking, and your top servers and channels.</p>
      </div>
      <div class="card">
        <h2>Messages, words and emoji</h2>
        <p class="muted">How much you've sent, to whom and where, when you're most active, your favourite words and emoji.</p>
      </div>
      <div class="card">
        <h2>Time on Discord</h2>
        <p class="muted">Hours with Discord open, sessions per device, and how often you open the app, react, join voice and more.</p>
      </div>
      <div class="card">
        <h2>Account and spending</h2>
        <p class="muted">Your profile, badges, friends, connected accounts, signed-in devices, and everything you've paid for.</p>
      </div>
      <div class="card">
        <h2>Any time range, shareable</h2>
        <p class="muted">Lifetime, the last 30 days, 6 or 12 months, or a single year, in your time zone. Share any of it as an image.</p>
      </div>
    </section>

    <section class="card private">
      <h2>Your package never leaves your computer</h2>
      <p class="muted">
        Some tools ask you to paste your package's download link so their server can fetch it. This one reads the ZIP
        in your browser tab. The results stay in your browser so you don't have to open the ZIP again, until you click
        Forget. The code is open source, so you can check.
      </p>
    </section>

    <section class="prose">
      <h2>See your Discord data, not just download it</h2>
      <p class="muted">
        Discord's data package is a ZIP of JSON files and multi-gigabyte event logs, not something you can read. Unpacked
        is a Discord data visualizer for it: it finds the parts that matter, works out the totals, and draws them as
        charts you can filter by year. It handles packages exported in 2026, in any language, and big ones too.
        Coming from another tool? Here's <a href="/discord-data-package-explorer-alternatives/">how the Discord data
        package viewers compare</a>.
      </p>
    </section>

    <section class="faq prose">
      <h2>Questions</h2>
      {faq.map(({ q, a }) => (
        <details>
          <summary>{q}</summary>
          <p class="muted">{a}</p>
        </details>
      ))}
    </section>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
</Base>

<style>
  .hero { padding-block: 40px 56px; max-width: 760px; }
  .lead { font-size: 1.2rem; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  .features h2 { font-size: 1.15rem; }
  .features p { margin: 0; }
  .private { margin-block: 32px; }
  .faq { margin-top: 40px; }
  .faq details { border-bottom: 1px solid var(--border); padding-block: 12px; }
  .faq summary { cursor: pointer; font-weight: 600; }
  .faq details p { margin: 8px 0 0; }
</style>
