---
import Base from "../layouts/Base.astro";
import "../styles/stats.css";
---

<Base
  title="Open your Discord data package: viewer and stats · Unpacked"
  description="Drop your Discord package.zip to analyze it: playtime, Go Live and voice time, messages, time on Discord and your account. Everything is read in your browser; nothing is uploaded."
>
  <div class="wrap">
    <section id="drop">
      <h1>Open your package</h1>
      <p class="muted">
        Choose the <code>package.zip</code> Discord emailed you. It's read right here in your browser and never uploaded.
        Don't have it yet? <a href="/request-your-discord-data/">Here's how to request it</a>{" "}
        (or see <a href="https://support.discord.com/hc/en-us/articles/360004027692-Requesting-a-Copy-of-your-Data" target="_blank" rel="noopener">Discord's help article</a>).
      </p>
      <label class="dropzone">
        <input id="file" type="file" accept=".zip,application/zip" />
        <span class="dropzone-title">Drop package.zip here</span>
        <span class="muted">or click to choose it</span>
      </label>
      <p class="demo-line">
        No package yet? <button id="demo" class="button ghost small">Try it with sample data</button>
      </p>
      <p class="muted small">
        Big packages (several GB of activity data) take a minute. The only network requests are to Discord's public
        game list and game icons, to put names and pictures on your games.
      </p>
    </section>

    <p id="error" class="notice error" role="alert" hidden></p>

    <section id="progress" hidden aria-live="polite">
      <h1>Reading your package</h1>
      <p><span id="phase">Starting</span> <span id="percent" class="muted"></span></p>
      <div class="progress"><div id="bar"></div></div>
      <button id="cancel" class="button ghost small">Cancel</button>
    </section>

    <section id="results" hidden></section>

    <dialog id="share" class="share" aria-labelledby="share-title">
      <div class="share-head">
        <h2 id="share-title">Share your stats</h2>
        <button class="button ghost small" id="share-close">Close</button>
      </div>
      <div class="chips" id="share-ranges" role="group" aria-label="Time range"></div>
      <canvas id="share-canvas" aria-label="Preview of the image"></canvas>
      <div class="share-actions">
        <label class="check"><input type="checkbox" id="share-name" checked /> Show my name</label>
        <span class="muted small" id="share-status" aria-live="polite"></span>
        <button class="button ghost small" id="share-native" hidden>Share…</button>
        <button class="button ghost small" id="share-download">Download PNG</button>
        <button class="button small" id="share-copy" hidden>Copy image</button>
      </div>
      <p class="muted small">The image is made in your browser. Copy it and paste it straight into Discord.</p>
    </dialog>
  </div>
</Base>

<script>
  import "../lib/stats-page.ts";
</script>
